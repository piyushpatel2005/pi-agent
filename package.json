{
  "name": "pi-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A workflow harness for coding agents: personas, guarded tools, checkpoints, and traceability.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pi": "./cli/pi.ts"
  },
  "files": [
    "cli",
    "core",
    "harness",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "docs:build": "node cli/pi.ts docs build",
    "docs:serve": "node cli/pi.ts docs serve",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.ts",
    "changes": "node scripts/changes.ts"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "shiki": "^3.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
